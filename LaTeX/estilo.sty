% ------------------------------------------------------------ títulos
\newcommand{\barradeg}[1][\linewidth]{%
  \par\nointerlineskip\vspace{3pt}%
  \tikz\shade[left color=azul,right color=white,middle color=azulmed!60]
    (0,0) rectangle (#1,1.1pt);\par}
\titleformat{\section}{\Large\bfseries\color{navy}}%
  {\thesection.}{0.55em}{}[\barradeg]
\titleformat{\subsection}{\large\bfseries\color{navy}}%
  {\thesubsection.}{0.55em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\color{navy}}%
  {\thesubsubsection.}{0.5em}{}
\titlespacing*{\section}{0pt}{3.0ex plus .6ex}{2.0ex}
\titlespacing*{\subsection}{0pt}{2.6ex plus .5ex}{1.4ex}

