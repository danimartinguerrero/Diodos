% ------------------------------------------------------------ cajas
\tcbuselibrary{theorems}
\tcbset{
  cajabase/.style={enhanced,breakable,sharp corners,boxrule=0pt,
    frame hidden,borderline west={2.2pt}{0pt}{#1},
    interior style={left color=#1!9!white,right color=white},
    left=9pt,right=8pt,top=6pt,bottom=6pt,
    before skip=9pt,after skip=9pt,
    fonttitle=\bfseries,coltitle=black,
    separator sign none,description delimiters parenthesis,
    description font=\mdseries\color{#1!80!white},
    detach title,before upper={{\upshape\tcbtitle}\quad}},
  lineas/.style={borderline north={.4pt}{0pt}{#1},borderline south={.4pt}{0pt}{#1}},
}
\newtcbtheorem[number within=section]{definicion}{Definición}%
  {cajabase=navy,description font=\mdseries\color{azul},lineas=grisclaro}{def}
\newtcbtheorem[use counter from=definicion]{proposicion}{Proposición}%
  {enhanced,breakable,frame hidden,interior hidden,boxrule=0pt,
   left=0pt,right=0pt,top=2pt,bottom=2pt,before skip=8pt,after skip=8pt,
   fonttitle=\bfseries,coltitle=black,fontupper=\itshape,
   separator sign none,description delimiters parenthesis,
   description font=\mdseries\color{azul},
   detach title,before upper={{\upshape\tcbtitle}.\quad}}{prop}
\newtcbtheorem[use counter from=definicion]{laboratorio}{En el laboratorio}%
  {cajabase=ambar,lineas=ambar!35}{lab}
\newtcbtheorem[use counter from=definicion]{precaucion}{Precaución}%
  {cajabase=rojoaviso,lineas=rojoaviso!35}{prec}

% Observación: título en cursiva azul, sin caja
\newenvironment{observacion}[1][]{%
  \par\addvspace{6pt}\noindent\refstepcounter{tcb@cnt@definicion}%
  {\color{azul}\itshape Observación~\thetcb@cnt@definicion}%
  \if\relax\detokenize{#1}\relax\else\ {\color{azul}(#1)}\fi.\ \ignorespaces}%
  {\par\addvspace{6pt}}
\newenvironment{demostracion}{\par\addvspace{4pt}\noindent\textit{Demostración.}\ }%
  {\hfill{\color{navy}\rule{1.4ex}{1.4ex}}\par\addvspace{6pt}}

% ecuación destacada (barra azul a la izquierda, fondo claro)
\newtcbox{\cajaec}{enhanced,nobeforeafter,tcbox raise base,sharp corners,
  boxrule=0pt,frame hidden,borderline west={1pt}{0pt}{azulmed},
  interior style={left color=azulpalido,right color=white},
  left=6pt,right=8pt,top=3pt,bottom=3pt}
\newenvironment{destacada}{\empheq[box=\cajaec]{equation}}{\endempheq}

